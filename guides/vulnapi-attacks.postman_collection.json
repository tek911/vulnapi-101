							"mode": "raw",
							"raw": "{\n    \"updates\": [\n        {\"product_id\": 1, \"price\": 0.01},\n        {\"product_id\": 2, \"price\": 0.01},\n        {\"product_id\": 3, \"price\": 0.01}\n    ]\n}"
